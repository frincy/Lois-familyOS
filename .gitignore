# ─── secrets & local state ───────────────────────────────────────────────────
.env
*.env
!*.env.example
app/.env

# Your personal data is yours — never committed to the public repo.
data/
!data.example/
!data.example/**

# Microsoft Graph tokens, learned preferences, sync caches — all live in data/
# but list explicitly in case anyone moves them.
**/connections/
**/learned.json
**/tickler.json
**/sync/

# ─── node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── editors / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── OneDrive sync turds (this repo may live inside a OneDrive folder) ───────
*.tmp
~$*
.~lock.*#

# ─── build artifacts ─────────────────────────────────────────────────────────
dist/
build/
*.log
