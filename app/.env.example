# ─── Family OS — app/.env ────────────────────────────────────────────────────
# Copy this file to `app/.env` (or run `npm run setup` from the repo root and
# it will be created for you). All values are read only on server startup.

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Cost per turn is small (~$0.05–0.12 depending on context length and the
# model below). Leave blank if you want the Agent SDK to fall back to an
# existing Claude Code session on this machine.
ANTHROPIC_API_KEY=

# Optional — which Claude model to use for the COS. Defaults to claude-opus-4-7.
# MODEL=claude-opus-4-7

# ─── Principal (the person the COS works for) ────────────────────────────────
# The first name (or however you want the COS to refer to you in prompts).
# Defaults to "the user" if blank.
PRINCIPAL_NAME=

# ─── Microsoft Graph (Outlook mail + calendar) — optional ────────────────────
# This is the *public* first-party client ID for Microsoft's "Graph Command
# Line Tools" application. It works for any personal Microsoft account via
# device-code flow, with NO Azure registration required.
# Leave the default unless you've registered your own app in Entra ID.
MS_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e

# ─── Server ──────────────────────────────────────────────────────────────────
# The local port. Default 4317.
# PORT=4317

# Hour at which the morning brief is allowed to auto-generate (24h, local).
# BRIEF_HOUR=7
